# JoyClub Associate web (TanStack Start → Nitro node-server)
FROM node:22-bookworm-slim AS build

WORKDIR /app
ENV DOCKER=1
ENV NITRO_PRESET=node-server

COPY package.json package-lock.json* bun.lock* ./
# lockfile may lag package.json in this repo; install is more resilient for VPS builds
RUN npm install --no-audit --no-fund

COPY . .
ARG VITE_API_URL=/api/v1
ARG VITE_BASE_PATH=/account/
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3000

COPY --from=build /app/.output ./.output
# Public downloads (APK) if present in build context
COPY --from=build /app/public/downloads ./public/downloads

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
